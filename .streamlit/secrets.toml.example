# Copy this file to `.streamlit/secrets.toml` and fill in your own values.
# This keeps secrets out of source control and works with Streamlit Cloud.

# Example values:
# SERPAPI_API_KEY = "your_serpapi_key"
# GOOGLE_CSE_KEY = "your_google_cse_key"
# GOOGLE_CSE_CX = "your_google_cse_cx"
# NUMVERIFY_API_KEY = "your_numverify_key"
